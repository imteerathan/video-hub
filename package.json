{
  "name": "video-hub",
  "version": "1.1.14",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "desktop:dev": "node scripts/desktop-dev.cjs",
    "desktop:build": "next build",
    "desktop:package": "electron-builder --win nsis portable --publish never",
    "desktop:prepare": "node scripts/prepare-desktop.cjs",
    "desktop:release": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "hls.js": "^1.6.13",
    "next": "^15.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5",
    "prisma": "^6.16.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2",
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.videohub.desktop",
    "productName": "Video Hub",
    "directories": {
      "output": "release"
    },
    "files": [
      ".next/standalone/**/*",
      ".next/static/**/*",
      "public/**/*",
      "prisma/**/*",
      "desktop/**/*",
      "package.json",
      "node_modules/prisma/**/*",
      "node_modules/@prisma/**/*",
      "node_modules/.prisma/**/*",
      "node_modules/@prisma/client/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/.prisma",
        "to": "app/node_modules/.prisma"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Video-Hub-Setup-${version}.${ext}"
    },
    "asar": false,
    "extraFiles": [
      {
        "from": "node_modules/.prisma",
        "to": "node_modules/.prisma"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "imteerathan",
        "repo": "video-hub",
        "releaseType": "release",
        "publishAutoUpdate": true,
        "vPrefixedTagName": true
      }
    ]
  },
  "description": "Personal video catalog and player desktop application",
  "author": "Video Hub",
  "repository": {
    "type": "git",
    "url": "https://github.com/imteerathan/video-hub.git"
  }
}
